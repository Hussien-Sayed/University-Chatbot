GROQ_API_KEY=your_groq_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
DATA_SOURCE_PATH=data/intents-v2.json
VDB_SAVE_PATH=data/vector_db
CHAT_LLM_MODEL=llama-3.1-8b-instant
EVAL_LLM_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TEST_DATA_PATH=data/rag_test_data.json
CHUNK_SIZE=500
CHUNK_OVERLAP=0
BM25_WEIGHT=0.5

# Options: structural, structural-formatted, non_structural
DOCUMENT_STRUCTURE_MODE=structural-formatted

# Retrieval type: vector, bm25, hybrid
RETRIEVAL_TYPE=vector

# Self-evaluation configuration (optional)
# Enable/disable self-evaluation feature (default: false)
ENABLE_SELF_EVAL=false

# Only used when ENABLE_SELF_EVAL=true
RELEVANCE_THRESHOLD=0.3
CONFIDENCE_THRESHOLD=0.4

# Query Fusion configuration (optional)
# Enable RAG-Fusion with query variants and reciprocal rank fusion (default: false)
ENABLE_QUERY_FUSION=true

# Only used when ENABLE_QUERY_FUSION=true
FUSION_NUM_VARIANTS=3
FUSION_K=60
FUSION_TOP_K=5

# Added by Settings page
RAG_EXPERIMENTS_DIR=data/evaluation_results

# Added by Settings page
FAISS_HNSW_EF_CONSTRUCTION=200
FAISS_HNSW_EF_SEARCH=128
FAISS_HNSW_M=8
FAISS_INDEX_TYPE=pq
FAISS_IVF_NLIST=10
FAISS_IVF_NPROBE=3
FAISS_PQ_M=8
FAISS_PQ_NBITS=4

# Added by Settings page
NUM_CHUNKS=3

# Added by Settings page
CHAT_LLM_PROVIDER=ollama
EVAL_LLM_PROVIDER=groq
